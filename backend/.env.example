# Local development defaults. Copy this file to backend/.env when overrides are needed.
SCHEDULE_APP_ENV=development
SCHEDULE_DATABASE_URL=sqlite:///data/app.db
SCHEDULE_API_HOST=0.0.0.0
SCHEDULE_API_PORT=8000
SCHEDULE_DEBUG=false
SCHEDULE_DOCS_ENABLED=true
SCHEDULE_CORS_ORIGINS=[]
SCHEDULE_LOG_LEVEL=INFO
SCHEDULE_LOG_FORMAT=console
SCHEDULE_LOG_FILE=
SCHEDULE_SQLITE_BUSY_TIMEOUT_MS=5000
SCHEDULE_DB_POOL_TIMEOUT_SECONDS=5
SCHEDULE_BACKUP_DIR=data/backups
SCHEDULE_BACKUP_KEEP=5
SCHEDULE_TIME_SYNC_ENABLED=false
SCHEDULE_TIME_SYNC_MIN_UTC=2025-01-01T00:00:00Z
SCHEDULE_TIME_SYNC_MAX_UTC=2035-01-01T00:00:00Z
SCHEDULE_TIME_SYNC_LOCK_TIMEOUT_SECONDS=2
SCHEDULE_TIME_SYNC_COMMAND_TIMEOUT_SECONDS=5
# Assistant model server (OpenAI-compatible). Off by default: the Assistant answers 503.
SCHEDULE_ASSISTANT_MODEL_ENABLED=false
SCHEDULE_ASSISTANT_MODEL_BASE_URL=http://127.0.0.1:8088
SCHEDULE_ASSISTANT_MODEL_NAME=
SCHEDULE_ASSISTANT_MODEL_TIMEOUT_SECONDS=60
SCHEDULE_ASSISTANT_TRUST_SERVER_TIME=false
