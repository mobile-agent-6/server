# Review and copy to backend/.env. No device IPs or secrets belong in this file.
SCHEDULE_APP_ENV=development
SCHEDULE_DATABASE_URL=sqlite:///data/app.db
SCHEDULE_API_HOST=0.0.0.0
SCHEDULE_API_PORT=8000
SCHEDULE_LOG_FORMAT=json
SCHEDULE_LOG_LEVEL=INFO
SCHEDULE_LOG_FILE=
SCHEDULE_BACKUP_DIR=data/backups
SCHEDULE_TIME_SYNC_ENABLED=false
SCHEDULE_ASSISTANT_MODEL_ENABLED=true
SCHEDULE_ASSISTANT_MODEL_BASE_URL=http://127.0.0.1:8080
SCHEDULE_ASSISTANT_MODEL_NAME=qwen440-v37
SCHEDULE_ASSISTANT_MODEL_TIMEOUT_SECONDS=110
SCHEDULE_ASSISTANT_TRUST_SERVER_TIME=false
SCHEDULE_VOICE_ENABLED=true
SCHEDULE_VOICE_SERVER_BASE_URL=http://127.0.0.1:8081
SCHEDULE_VOICE_SERVER_TIMEOUT_SECONDS=30
